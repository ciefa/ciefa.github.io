{
  "name": "local-html-reviewer",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --grep-invert @performance",
    "test:chromium": "playwright test --project=chromium --grep-invert @performance",
    "test:performance": "playwright test tests/performance.spec.cjs tests/roundtrip-performance.spec.cjs tests/markdown-performance.spec.cjs --project=chromium",
    "build:roundtrip": "node scripts/build-roundtrip.mjs",
    "check:roundtrip-build": "node scripts/build-roundtrip.mjs --check",
    "test:roundtrip": "playwright test tests/roundtrip-*.spec.cjs --grep-invert @performance",
    "build:markdown": "node scripts/build-markdown.mjs",
    "check:markdown-build": "node scripts/build-markdown.mjs --check",
    "build": "npm run build:roundtrip && npm run build:markdown",
    "check:build": "npm run check:roundtrip-build && npm run check:markdown-build",
    "test:markdown": "playwright test tests/markdown-*.spec.cjs --grep-invert @performance"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "entities": "6.0.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "micromark": "4.0.2",
    "parse5": "8.0.0"
  }
}
